# Use the same secret for the web proxy and private API. Generate at least 32 random characters.
TRANSLATION_API_KEY=
TRANSLATION_API_URL=http://localhost:8000

# CPU-friendly private translation model
TRANSLATION_PROVIDER=marian
TRANSLATION_MODEL=Helsinki-NLP/opus-mt-ur-en

# Private speech-to-text
SPEECH_MODEL=small
SPEECH_DEVICE=cpu
SPEECH_COMPUTE_TYPE=int8

# Private text-to-speech (single Urdu voice, no speed control)
SPEECH_SYNTHESIS_MODEL=facebook/mms-tts-urd-script_arabic

# Best-effort transcript grammar/punctuation correction (via a local Ollama model).
# Not guaranteed correct - see README. Requires Ollama running locally with the
# given model pulled (`ollama pull qwen2.5:7b-instruct`).
ENABLE_TRANSCRIPT_CORRECTION=true
GRAMMAR_CORRECTION_BASE_URL=http://localhost:11434
GRAMMAR_CORRECTION_MODEL=qwen2.5:7b-instruct

# Request and network policy
MAX_CHARACTERS=5000
MAX_AUDIO_BYTES=15728640
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
REQUEST_TIMEOUT_SECONDS=45
REQUIRE_HTTPS=false
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=api,localhost,127.0.0.1
EXPOSE_API_DOCS=false

# Private vLLM profile (used by docker-compose.gpu.yml)
INFERENCE_BASE_URL=http://model:8000
INFERENCE_API_KEY=local-private-model
ALLOW_PUBLIC_INFERENCE_URL=false
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_IMAGE=vllm/vllm-openai:latest
