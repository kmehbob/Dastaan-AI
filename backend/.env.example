# Copy this file to backend/.env for running the backend directly with
# `uvicorn app.main:app --reload` (outside Docker). Docker Compose does not
# use this file - it injects the same variables from the repo-root .env.

# Must match the web app's TRANSLATION_API_KEY (see ../.env.example).
# Generate at least 32 random characters.
TRANSLATION_API_KEY=

# CPU-friendly private translation model
TRANSLATION_PROVIDER=marian
TRANSLATION_MODEL=Helsinki-NLP/opus-mt-ur-en

# Private speech-to-text
SPEECH_MODEL=small
SPEECH_DEVICE=cpu
SPEECH_COMPUTE_TYPE=int8

# Request and network policy
MAX_CHARACTERS=5000
MAX_AUDIO_BYTES=15728640
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
REQUEST_TIMEOUT_SECONDS=45
REQUIRE_HTTPS=false
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=api,localhost,127.0.0.1
EXPOSE_API_DOCS=false
